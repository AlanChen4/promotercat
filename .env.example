# Copy this file to .env.local and replace the placeholders.
# Next.js loads .env.local automatically; the :local CLI scripts load it explicitly.

# Local Supabase: run pnpm db:start, then pnpm db:status to get these values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Vercel AI Gateway: used for search embeddings and policy classification.
VERCEL_AI_GATEWAY=replace-with-ai-gateway-key

# Subreddit ingestion and refresh services.
TINYFISH_API_KEY=replace-with-tinyfish-key
# JSON array; add more keys if needed.
APIFY_API_KEYS='["replace-with-apify-key"]'

# Secret used to authorize scheduled refresh requests.
CRON_SECRET=replace-with-a-random-secret

# PostHog project key for browser analytics.
NEXT_PUBLIC_POSTHOG_KEY=replace-with-posthog-project-key
